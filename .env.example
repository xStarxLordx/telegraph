# Firebase web config (Firebase console > Project settings > General > Your apps > Web app).
# Copy this file to `.env.local` (ignored by Git) and fill in the values.
# The config is not secret: Firestore security rules protect the data.
# Vite only exposes variables that start with VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
