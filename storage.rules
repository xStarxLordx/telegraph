rules_version = '2';

// Cloud Storage holds only the pictures, GIFs and videos of tweets. Everything not listed here is
// denied. The types and limits mirror src/domain/media.ts and constants.ts (MAX_IMAGE_MB = 5,
// MAX_GIF_MB = 10, MAX_VIDEO_MB = 20): keep them in sync. storageRules.test.ts fails when they
// drift.
service firebase.storage {
  match /b/{bucket}/o {

    // tweet-media/{uid}/{random}.{ext}: written once, by the account that owns the folder; never
    // replaced or deleted. Reading needs a signed-in user, but anyone who has the file's download
    // URL (which a tweet carries) can open it: an accepted trade-off, noted in the README.
    match /tweet-media/{uid}/{file} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && file.matches('[0-9a-f-]+[.](jpg|png|webp|gif|mp4|webm)')
        && ((request.resource.contentType.matches('image/(jpeg|png|webp)')
              && request.resource.size <= 5 * 1024 * 1024)
          || (request.resource.contentType == 'image/gif'
              && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm)')
              && request.resource.size <= 20 * 1024 * 1024));

      allow update, delete: if false;
    }
  }
}
